# .env.example — copy to .env and fill in real values. NEVER commit the real .env.

APP_NAME=aletheia-api-gateway
ENVIRONMENT=local
LOG_LEVEL=INFO

# Postgres — system of record. Note "+psycopg" — that's psycopg3, not psycopg2.
DATABASE_URL=postgresql+psycopg://aletheia:changeme@postgres:5432/aletheia
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=20

# Qdrant — vector index only. No embeddings ever live in Postgres.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=aletheia

# Redis — Celery broker + result backend
REDIS_URL=redis://redis:6379/0

# Inference service (embedder / reranker / Ollama proxy)
INFERENCE_SERVICE_URL=http://inference-service:8100
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Embedding / retrieval tuning
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
MAX_UPLOAD_MB=25

# Auth — CHANGE JWT_SECRET_KEY before this ever leaves your laptop
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS — pydantic-settings parses this as JSON, so it must be a JSON array
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Read by the Postgres Docker image itself later, not by app code —
# but must stay consistent with the credentials inside DATABASE_URL above
POSTGRES_USER=aletheia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aletheia

# --- LLM provider selection ------------------------------------------
    llm_provider: Literal["ollama", "groq"] = Field(default="ollama")
    groq_api_key: str | None = Field(default=None)
    groq_model: str = Field(default="llama-3.1-8b-instant")


# When starting inference-service, install the right torch variant:
#   CPU (any machine):    uv sync --extra cpu
#   CUDA 12.6 (NVIDIA):  uv sync --extra cuda